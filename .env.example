# Secret admin URL segment: the admin panel lives at https://your-domain/<ADMIN_PATH>
# Use something long and unguessable (6-64 chars: letters, digits, "-" or "_").
ADMIN_PATH=quan-tri-doi-ten-nay-8f3k2
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password
# Random string used to sign admin sessions (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
# Port inside the container. Coolify routes to it; nothing is published on the host.
PORT=3000
